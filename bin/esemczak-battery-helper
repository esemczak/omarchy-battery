#!/bin/bash
# Privileged battery charge helper (run via pkexec). Self-contained.
#   esemczak-battery-helper mode <Name>
#   esemczak-battery-helper limits <start> <end>
# Exit: 0 ok, 2 invalid argument/unsupported, 3 failed write.
set -euo pipefail
PATH=/usr/bin:/bin
export PATH

# BATTERY_SYSFS is a test hook, honoured only for unprivileged callers.
if [[ $EUID -eq 0 ]]; then
  root=/sys/class/power_supply
else
  root=${BATTERY_SYSFS:-/sys/class/power_supply}
fi

die() { exit "$1"; }

bat=""
for d in "$root"/BAT*; do
  if [[ -d $d ]]; then bat=$d; break; fi
done
[[ -n $bat ]] || die 2

# Write a value to a sysfs file; any failure is exit 3.
put() { printf '%s' "$2" >"$1" 2>/dev/null || die 3; }

cmd=${1:-}
case $cmd in
  mode)
    [[ $# -eq 2 ]] || die 2
    want=$2
    [[ $want =~ ^[A-Za-z0-9_-]+$ ]] || die 2
    f=$bat/charge_types
    [[ -r $f && -w $f ]] || die 2
    raw=$(tr -d '\n' <"$f" 2>/dev/null) || die 2
    ok=0
    read -ra words <<<"$raw" || true
    for w in "${words[@]}"; do
      w=${w//[\[\]]/}
      if [[ $w == "$want" ]]; then ok=1; break; fi
    done
    [[ $ok -eq 1 ]] || die 2
    put "$f" "$want"
    ;;
  limits)
    [[ $# -eq 3 ]] || die 2
    s=$2; e=$3
    re='^[1-9][0-9]{0,2}$'
    [[ $s =~ $re && $e =~ $re ]] || die 2
    (( s >= 1 && s < e && e <= 100 )) || die 2
    fs=$bat/charge_control_start_threshold
    fe=$bat/charge_control_end_threshold
    [[ -e $fs && -e $fe ]] || die 2
    cur=$(tr -d '\n' <"$fe" 2>/dev/null) || die 3
    [[ $cur =~ ^[0-9]+$ ]] || die 3
    if (( s >= cur )); then
      put "$fe" "$e"; put "$fs" "$s"
    else
      put "$fs" "$s"; put "$fe" "$e"
    fi
    ;;
  *) die 2 ;;
esac
exit 0
